---
// The site footer, written once. Links come from src/config/site.ts.
// The copyright year is kept current by wwuai.js (2026, then 2026–2027...).
import { footerLinks, social, site } from '../config/site';
import SocialIcon from './SocialIcon.astro';
const external = (href: string) => /^https?:/.test(href);
---
<footer class="site-foot tone-pearl">
  <div class="wrap">
    <span>&copy; <span class="yr">2026</span> {site.name} &middot; Melbourne, Australia</span>
    <span class="site-foot__links">{footerLinks.map((l) => external(l.href)
      ? <a href={l.href} target="_blank" rel="noopener">{l.label}</a>
      : <a href={l.href}>{l.label}</a>)}</span>
    <span class="site-foot__social">
      {social.map((s) => <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}><SocialIcon id={s.id} /></a>)}
    </span>
  </div>
</footer>
