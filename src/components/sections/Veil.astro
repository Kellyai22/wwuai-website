---
// /style 08. Full-bleed photo under a Bordeaux veil. Text runs the full width, high on the photo.
interface Props { photo: { src: string; width: number; height: number; alt?: string } }
const { photo } = Astro.props;
---
<section class="veil">
  <div class="veil__img"><img src={photo.src} width={photo.width} height={photo.height} loading="lazy" decoding="async" alt={photo.alt ?? ''}></div>
  <div class="wrap">
<slot />
  </div>
</section>
