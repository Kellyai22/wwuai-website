---
// /style 07. About Kelly, with the photo that wipes open. Facts from the founder story only.
// "head" slot = kicker and headline above the split (home page shape); or put them in the default slot.
interface Props {
  tone?: 'pearl' | 'greige';
  id?: string;
  photo: { src: string; width: number; height: number; alt: string };
}
const { tone = 'pearl', id, photo } = Astro.props;
const hasHead = Astro.slots.has('head');
---
<section class={`s about tone-${tone}`} id={id}>
  <div class="wrap">
<slot name="head" />
    <div class="split" style={hasHead ? 'margin-top:var(--s5)' : undefined}>
      <div class="about__photo" data-wipe><img src={photo.src} width={photo.width} height={photo.height} loading="lazy" decoding="async" alt={photo.alt}></div>
      <div data-reveal={hasHead ? '' : undefined}>
<slot />
      </div>
    </div>
  </div>
</section>
