---
// Home page. Main button: the free Business Dependency Check (/check), which
// leads to the workshop and then Architect Advantage (the offer panel).
// Design approved by Kelly 11 Nov 2026; Check button and membership list 13 Nov.
// Scroll-gated: nothing moves until the first scroll.
import Sales from '../layouts/Sales.astro';
import Section from '../components/sections/Section.astro';
import HeroLayered from '../components/sections/HeroLayered.astro';
import Grow from '../components/sections/Grow.astro';
import Dealt from '../components/sections/Dealt.astro';
import Statement from '../components/sections/Statement.astro';
import Ruled from '../components/sections/Ruled.astro';
import Offer from '../components/sections/Offer.astro';
import About from '../components/sections/About.astro';
import Band from '../components/sections/Band.astro';
import Faq from '../components/sections/Faq.astro';
import { nextStep, steps } from '../config/site';

const faqs = [
  { q: 'What is Wise Women Use AI?', a: 'Practical ai and business systems for women running their own businesses, with Gen X women at its heart. Founded by Kelly Hartley in Melbourne, it helps you keep the work that needs your judgement and redesign the rest.' },
  { q: 'Do I need to be technical?', a: 'No coding is needed to start. Begin with a job you understand and a tool you are comfortable using. More involved systems take practice, testing and time to set up.' },
  { q: 'What is free, and what is paid?', a: 'The Check, the monthly workshop and the free resources cost nothing. Architect Advantage is the paid membership: a new business system with everything needed to set it up, a live build call and a live Q&A call, both recorded, plus every system so far in Your AI Team, Your Business HQ, and the replays of every call. It is $69 USD per month, billed through Skool. Cancel any time.' },
  { q: 'Which ai tools do you use?', a: 'Primarily Claude, with ChatGPT foundations too. The job comes first. Sometimes a checklist or clearer process is more useful than another ai tool.' },
  { q: 'Will you build the system for me?', a: 'Architect Advantage is supported DIY implementation. You bring your work, build your version and check its results. Kelly provides the resources, examples and implementation support. Bespoke setup is not included.' },
];
---
<Sales
  title="AI & Business Systems for Women | Wise Women Use AI"
  description="Practical AI and business systems for Gen X women. Build with support in Architect Advantage."
  path="/"
  motion="scroll"
  follow
  next="check"
>
<script type="application/ld+json" is:inline slot="head">{"@context": "https://schema.org", "@graph": [{"@type": "Organization", "@id": "https://www.wisewomenuseai.com/#organization", "name": "Wise Women Use AI", "url": "https://www.wisewomenuseai.com", "logo": "https://www.wisewomenuseai.com/assets/logos/WWUAI Logo OGTP.png", "description": "Practical AI and business systems for Gen X women running their own businesses. Keep the work that needs your judgement and redesign the rest.", "founder": {"@type": "Person", "name": "Kelly Hartley", "url": "https://www.wisewomenuseai.com/about", "jobTitle": "AI Consultant and Educator"}, "address": {"@type": "PostalAddress", "addressLocality": "Melbourne", "addressRegion": "VIC", "addressCountry": "AU"}, "sameAs": ["https://www.linkedin.com/in/wisewomenuseai", "https://www.tiktok.com/@kellyh.ai", "https://www.instagram.com/kellyh.ai", "https://www.facebook.com/wisewomenuseai", "https://www.threads.net/@wisewomenuseai", "https://substack.com/@wisewomenuseai"]}, {"@type": "WebSite", "@id": "https://www.wisewomenuseai.com/#website", "url": "https://www.wisewomenuseai.com", "name": "Wise Women Use AI", "publisher": {"@id": "https://www.wisewomenuseai.com/#organization"}}, {"@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "What is Wise Women Use AI?", "acceptedAnswer": {"@type": "Answer", "text": "Practical AI and business systems for women running their own businesses, with Gen X women at its heart. Founded by Kelly Hartley in Melbourne, it helps you keep the work that needs your judgement and redesign the rest."}}, {"@type": "Question", "name": "Do I need to be technical?", "acceptedAnswer": {"@type": "Answer", "text": "No coding is needed to start. Begin with a job you understand and a tool you are comfortable using. More involved systems take practice, testing and time to set up."}}, {"@type": "Question", "name": "What is free, and what is paid?", "acceptedAnswer": {"@type": "Answer", "text": "The Check, the monthly workshop and the free resources cost nothing. Architect Advantage is the paid membership: a new business system with everything needed to set it up, a live build call and a live Q&A call, both recorded, plus every system so far in Your AI Team, Your Business HQ, and the replays of every call. It is $69 USD per month, billed through Skool. Cancel any time."}}, {"@type": "Question", "name": "Which AI tools do you use?", "acceptedAnswer": {"@type": "Answer", "text": "Primarily Claude, with ChatGPT foundations too. The job comes first. Sometimes a checklist or clearer process is more useful than another AI tool."}}, {"@type": "Question", "name": "Will you build the system for me?", "acceptedAnswer": {"@type": "Answer", "text": "Architect Advantage is supported DIY implementation. You bring your work, build your version and check its results. Kelly provides the resources, examples and implementation support. Bespoke setup is not included."}}]}]}</script>

<HeroLayered
  kicker="Practical ai &amp; business systems for Gen&nbsp;X&nbsp;women"
  lines={['Your business', "shouldn't need you", 'for <span class="em">everything</span>']}
  lead="Keep the work that needs your judgement. Build better ways to handle the jobs that keep coming back to you."
  proof="Built from experience in buying, operations and running businesses. Tested on real work, with honest limits."
  photo={{ src: '/assets/photos/kelly-smiling-20260928.webp', width: 1254, height: 1254, alt: 'Kelly Hartley, founder of Wise Women Use AI', eager: true }}
  noteLine="Keep the work that needs you. Redesign the rest."
  noteName="Kelly Hartley"
>
  <Fragment slot="actions">
        <a class="btn btn--fill" href={steps.check.href}>{steps.check.label} <span class="arrow" aria-hidden="true">→</span></a>
        <a class="textlink" href={nextStep.href}>{nextStep.label}</a>
  </Fragment>
</HeroLayered>

<Grow id="work-around" kicker="The work around the work">
  <Fragment slot="title">You're capable. Too much still <span class="em">waits</span> <span class="nb">for you.</span></Fragment>
  <Dealt cards={[
    { title: 'The answer lives in your head', body: 'You know what to do, but every question comes back to you before anyone can move.' },
    { title: 'You keep starting again', body: 'The same email, content brief or weekly admin job gets rebuilt instead of reused.' },
    { title: "A faster task isn't enough", body: 'ai helps with a draft, but you still carry the reminders, decisions and checking around it.' },
  ]} />
</Grow>

<Section tone="greige" id="philosophy">
    <p class="kicker" data-reveal>Work That Needs You</p>
    <h2 class="title">Build a business that leaves room for your <span class="em">life</span></h2>
    <Statement line="Keep the work that needs you. Redesign the rest.">
      <p>Your judgement, experience, relationships and ideas matter. They don't need to be buried under work you could handle another way.</p>
      <p>Start by deciding what needs your attention. Then choose whether the rest needs ai assistance, a checklist, automation, delegation or simply to stop. You don't have to build a huge team or become a tech expert.</p>
    </Statement>
</Section>

<Section tone="pearl" id="examples">
    <p class="kicker" data-reveal>A useful place to begin</p>
    <h2 class="title">What could this look like in <span class="nb">your business?</span></h2>
    <p class="lead" data-reveal>These are possible starting projects. The right one depends on your work, your tools and the checks it needs.</p>
    <Ruled>
      <article data-reveal><h3>Content you can build on</h3><dl><dt>You start with</dt><dd>One idea, a voice-note transcript or an answer you give customers.</dd><dt>The system prepares</dt><dd>Drafts for different places, using the same source material.</dd><dt>You still decide</dt><dd>What is true, what sounds like you and what is worth publishing.</dd></dl></article>
      <article data-reveal><h3>Client enquiries</h3><dl><dt>You start with</dt><dd>An enquiry, your current offer details and your reply guidelines.</dd><dt>The system prepares</dt><dd>A reply draft and a follow-up checklist.</dd><dt>You still decide</dt><dd>Fit, pricing, promises and the final message before it is sent.</dd></dl></article>
      <article data-reveal><h3>Recurring admin</h3><dl><dt>You start with</dt><dd>Notes and updates that arrive in different places each week.</dd><dt>The system prepares</dt><dd>A consistent task list, with missing information flagged.</dd><dt>You still decide</dt><dd>What matters this week, who owns each action and what needs checking.</dd></dl></article>
    </Ruled>
    <p class="note" data-reveal>The content workflow is listed in the Architect Advantage Systems Library. The enquiry and admin examples show ways to apply the approach, rather than promises of ready-made membership tools.</p>

    <div class="part">
      <p class="kicker" data-reveal>An example from Wise Women</p>
      <h3 class="title">One idea into three useful drafts.</h3>
      <p class="lead" data-reveal>A written walkthrough of the content approach used in Wise Women, with sample text so you can see the decisions involved.</p>
      <Ruled>
        <div data-reveal><span class="ruled__label">01 · The input</span><h3>Your thinking comes first</h3><p>A real idea, the person it helps and the facts you can stand behind. Leave private customer details out.</p></div>
        <div data-reveal><span class="ruled__label">02 · The output</span><h3>Three useful drafts</h3><p>A short post, an email opening and a practical tip. Each has a different job and uses the same source.</p></div>
        <div data-reveal><span class="ruled__label">03 · The human check</span><h3>You choose what goes out</h3><p>Check the facts and tone, remove unsupported claims, and save the instructions with the approved version.</p></div>
      </Ruled>
      <p class="note" data-reveal><strong>Before:</strong> rebuild the brief for every draft. <strong>After:</strong> reuse one source, a clear instruction and a review checklist. Setup and checking still count as work.</p>
      <div class="btn-row" data-reveal><a class="btn" href="/examples/one-idea-three-drafts">See the complete example <span class="arrow" aria-hidden="true">→</span></a></div>
    </div>
</Section>

<Offer
  id="ways-to-start"
  kicker="Your next step"
  title="Build it with support, in Architect Advantage"
  price="$69"
  per="USD / month"
  lead="Build, test and improve useful systems with practical implementation support."
  items={[
    'A new business system for established service businesses, with everything needed to set it up',
    'A live build call to set it up together, and a live Q&A call, both recorded',
    'A before and after check with each system, so you see the difference',
    'The Business Dependency Diagnostic, to choose what to fix next',
    'Your AI Team: every system so far, filed under the role it takes off your plate, from receptionist to client care coordinator',
    'Your Business HQ: one home for how your business runs, so it stops living in your head',
    'The replays: every build call, Q&A call and workshop, to watch when it suits you',
    'Help in Skool when you get stuck',
  ]}
  note="Supported DIY. Billed monthly through Skool. Cancel any time. ai software subscriptions are separate."
/>

<Section tone="pearl" id="resources">
    <p class="kicker" data-reveal>Free resources, open to everyone</p>
    <h2 class="title">Choose the resource for the job in front <span class="nb">of you.</span></h2>
    <p class="lead" data-reveal>Guides, prompts and small tools, open without a passcode or sign-up. Start with the Check if you are not sure where to begin.</p>
    <div class="btn-row" data-reveal><a class="btn" href="/vault">Browse all free resources <span class="arrow" aria-hidden="true">→</span></a></div>
</Section>

<About tone="greige" id="about" photo={{ src: '/assets/photos/kelly-desk-20260928.webp', width: 1374, height: 1145, alt: 'Kelly working at her desk' }}>
  <Fragment slot="head">
    <p class="kicker" data-reveal>About Kelly</p>
    <h2 class="title">I know what it takes to keep the <span class="nb">work moving.</span></h2>
  </Fragment>
        <p class="lead">My background includes buying, operations and running businesses. I've worked with purchasing, stock, suppliers, people and the recurring jobs that need to happen whether you're there or not.</p>
        <p class="soft">I'm British, based in Melbourne, and building Wise Women for women who want their experience to count. I use ai in my own businesses and keep checking where it helps, where it adds work and what still needs me.</p>
        <p class="soft">One example is content: capture the thinking first, use it to prepare drafts, then check the facts and voice before anything is published. That review is part of the system.</p>
        <p><a class="textlink" href="/about">More about me and how I work →</a></p>
</About>

<Band>
    <p class="kicker" data-reveal>For organisations, councils &amp; business communities</p>
    <h2 class="title">Help your people use ai for work they actually do.</h2>
    <p class="band__meta lead" data-reveal>A practical workshop where participants start a useful way of working, with prompts to repeat it and a clear next step.</p>
    <p class="band__meta" data-reveal>90-minute core workshop. Online across Australia or in person in Melbourne. The format and examples are agreed with the organiser.</p>
    <div class="btn-row" data-reveal><a class="btn" href="/work">Explore organisational workshops <span class="arrow" aria-hidden="true">→</span></a></div>
</Band>

<Section tone="pearl" class="faq" id="faq">
    <h2 class="title">Common questions, honest answers.</h2>
    <Faq items={faqs} stacked />
</Section>


</Sales>
