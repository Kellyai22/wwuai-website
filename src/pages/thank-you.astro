---
import Legacy from '../layouts/Legacy.astro';
import LegacyNav from '../components/legacy/LegacyNav.astro';
import LegacyFooter from '../components/legacy/LegacyFooter.astro';
import { nextStep } from '../config/site';
---
<Legacy lang="en-AU">
<Fragment slot="head">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1"><title>Your free resource | Wise Women Use AI</title>
<meta name="description" content="Open your free Wise Women Use AI resource and choose your next step.">
<meta name="robots" content="noindex,follow">
<link rel="canonical" href="https://www.wisewomenuseai.com/thank-you">
<link href="https://fonts.googleapis.com/css2?family=Allison&amp;family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&amp;family=Plus+Jakarta+Sans:wght@400;500;600&amp;display=swap" rel="stylesheet"><style is:inline>:root{--bordeaux:#3A131B;--pearl:#FAF8F6;--clay:#DDA983;--blush:#E2B592;--driftwood:#908486;--creamDark:#E1DAD7;}

*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--pearl);color:var(--bordeaux);font:400 16px/1.75 'Plus Jakarta Sans',Arial,sans-serif}
a{color:inherit;text-underline-offset:4px}
img{max-width:100%;height:auto}
h1,h2,h3{font-family:'Playfair Display',Georgia,serif;font-weight:400;line-height:1.15;margin:0 0 22px}
h1{font-size:clamp(44px,5.6vw,76px);letter-spacing:-.025em}
h2{font-size:clamp(32px,3.8vw,48px)}
h3{font-size:26px}
p{margin:0 0 20px}
li{margin-bottom:9px}
em{font-weight:400}
.script{font-family:'Allison',cursive;font-size:1.22em;font-style:normal}
.wrap{width:min(1120px,calc(100% - 48px));margin:auto}
.section{padding:64px 0}
.eyebrow{font-size:12px;letter-spacing:.12em;font-weight:600;margin-bottom:16px}
.lead{font-size:19px;max-width:730px}
.muted{opacity:.8}
.small{font-size:14px}
.actions{display:flex;gap:14px;align-items:center;flex-wrap:wrap;margin:26px 0 16px}
.button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 20px;border:1.5px solid currentColor;border-radius:2px;text-decoration:none;font-weight:500;font-size:14px}
.button:hover{background:var(--bordeaux);color:var(--pearl)}
.dark .button:hover{background:var(--pearl);color:var(--bordeaux)}
.text-link{padding:10px 0}
.hero-grid{display:grid;grid-template-columns:1.15fr .85fr;align-items:center;gap:60px}
.hero-photo{width:100%;aspect-ratio:1/1;object-fit:cover;object-position:center;border-radius:3px}
.hero-caption{font-size:13px;margin-top:10px}
.hero-copy .lead{max-width:590px}
.grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin-top:32px}
.grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px;margin-top:28px}
.card{padding:28px;border:1px solid var(--creamDark);background:var(--pearl)}
.card p:last-child{margin-bottom:0}
.card dl{margin:0}
.card dt{font-size:13px;font-weight:600;margin-top:18px}
.card dd{margin:4px 0 0;font-size:15px}
.dark{background:var(--bordeaux);color:var(--pearl)}
.dark h2 em{color:var(--blush)}
.dark .card{background:transparent;border-color:var(--driftwood)}
.soft{background:var(--creamDark)}
.narrow{max-width:760px}
.proof{border-top:1px solid var(--creamDark);border-bottom:1px solid var(--creamDark);padding:20px 0}
.proof p{margin:0;font-size:14px}
.step-label{display:block;font-size:12px;font-weight:600;margin-bottom:12px}
.walkthrough{margin-top:30px}
.walkthrough .card{border-top:3px solid var(--clay)}
blockquote{margin:20px 0;padding-left:20px;border-left:3px solid var(--clay)}
.offer{display:flex;flex-direction:column}
.offer .actions{margin-top:auto;padding-top:18px}
.offer ul{padding-left:20px}
.price{font-family:'Playfair Display',serif;font-size:36px;margin:8px 0 22px}
.price small{font-family:'Plus Jakarta Sans',sans-serif;font-size:14px}
.portrait{aspect-ratio:4/5;object-fit:cover;width:100%;max-height:520px}
.split{display:grid;grid-template-columns:.8fr 1.2fr;gap:48px;align-items:center}
.faq details{padding:20px 0;border-bottom:1px solid var(--creamDark)}
summary{cursor:pointer;font-weight:500;min-height:28px}
.faq details p{margin:16px 0 0}
.signup{max-width:680px}
.signup label{display:block;font-size:14px;margin:14px 0 5px}
.signup input{width:100%;font:inherit;font-size:16px;padding:14px;background:var(--pearl);border:1px solid var(--driftwood);color:var(--bordeaux);border-radius:2px}
.signup button{font-family:inherit;background:transparent;color:inherit;cursor:pointer;margin-top:18px}
.signup [role=alert]{margin-top:16px}
.signup button:disabled{opacity:.6;cursor:wait}
.resource-link{display:block;padding:22px;border:1px solid var(--creamDark);text-decoration:none}
.resource-link strong{display:block;font-family:'Playfair Display',serif;font-size:23px;margin-bottom:8px}
.resource-link:hover{background:var(--creamDark)}
.site-footer{padding:32px 24px;border-top:1px solid var(--creamDark);text-align:center}
.footer-brand{display:flex;gap:12px;justify-content:center;align-items:center;text-decoration:none}
.footer-brand img{width:36px}
.footer-links{display:flex;flex-wrap:wrap;justify-content:center;gap:12px 22px;margin:24px auto;max-width:950px}
.footer-link,.footer-legal{font-size:13px}
.social-links{display:flex;justify-content:center;gap:20px;margin-bottom:22px}
pre{white-space:pre-wrap;overflow-wrap:anywhere;font:inherit;padding:24px;background:var(--creamDark)}
:focus-visible{outline:3px solid var(--bordeaux);outline-offset:5px}
.dark :focus-visible{outline-color:var(--blush)}
section[id]{scroll-margin-top:110px}
.skip{position:absolute;left:-10000px;top:0}
.skip:focus{left:12px;z-index:1000;background:var(--pearl);padding:12px}
@media(max-width:760px){.wrap{width:calc(100% - 36px)}
.section{padding:40px 0}
.hero-grid,.split,.grid2,.grid3{grid-template-columns:1fr;gap:22px}
.hero-grid{gap:28px}
.hero-photo{max-height:340px;aspect-ratio:4/3}
.hero-copy{order:0}
.hero-visual{order:1}
.lead{font-size:17px}
.card{padding:24px}
.actions{align-items:stretch}
.hero-copy .actions{flex-direction:column;align-items:flex-start}
h1{font-size:46px}
.portrait{max-height:360px;aspect-ratio:4/3}
.price{font-size:32px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}

.ww-nav{position:sticky!important;top:0;z-index:100;display:flex!important;align-items:center;justify-content:space-between;gap:20px;padding:12px max(24px,calc((100vw - 1120px)/2))!important;height:auto!important;min-height:68px;background:var(--pearl,#FAF8F6);color:var(--bordeaux,#3A131B);border-bottom:1px solid var(--creamDark,#E1DAD7);font:400 13px/1.4 'Plus Jakarta Sans',Arial,sans-serif}
.ww-brand{display:flex;align-items:center;gap:10px;text-decoration:none}
.ww-brand img{width:36px;height:36px;object-fit:contain}
.ww-brand span{font-size:11px;letter-spacing:.08em}
.ww-nav-links{display:flex;align-items:center;gap:24px}
.ww-nav-links a{display:inline-flex!important;align-items:center;min-height:44px;color:inherit;text-decoration:none}
.ww-nav-links a:hover{text-decoration:underline}
.ww-start{border:1px solid currentColor;padding:8px 14px;border-radius:2px}
.ww-nav a:focus-visible{outline:2px solid currentColor;outline-offset:4px}
.skip{position:absolute;left:-10000px;top:0}
.skip:focus{left:12px;z-index:1000;background:var(--pearl,#FAF8F6);padding:12px}
.section-nav{position:static!important}
@media(max-width:760px){.ww-nav{padding:10px 16px!important;gap:12px;flex-wrap:wrap}
.ww-brand span{display:none}
.ww-nav-links{gap:13px;flex:1;justify-content:flex-end;font-size:12px}
.ww-start{padding:8px 10px}}
@media(max-width:360px){.ww-nav-links{gap:8px;font-size:11px}
.ww-brand img{width:28px;height:28px}}
</style></Fragment>
<a class="skip" href="#main">Skip to content</a>
<LegacyNav variant="ww" />
<main id="main">
<section class="section">
<div class="wrap narrow">
<p class="eyebrow">YOUR NEXT STEP</p>
<h1>Your resource, <em>ready to use.</em></h1>
<div id="requested-resource" hidden><a id="resource-link" class="button"></a></div><p class="lead">Choose the resource you requested below. You can open it here without waiting for an email.</p>
<p>If Kit sends you a confirmation email, follow its instructions to confirm your email subscription. Check your spam or promotions folder too. Opening this page does not by itself confirm an email subscription.</p>
<div class="grid2"><a class="resource-link" href="/vault-starter"><strong>Set up your Claude Project</strong>One Claude Project that already knows your business, in about 20 minutes.</a><a class="resource-link" href="/vault-claude-clearly"><strong>Claude, Clearly</strong>Understand the basics and get started with Claude.</a><a class="resource-link" href="/switch"><strong>Switch to Claude</strong>Return to the guide for ChatGPT users moving to Claude.</a></div>
<p style="margin-top:28px">Need help getting your resource? Email <a href="mailto:hello@wisewomenuseai.com">hello@wisewomenuseai.com</a> with the name of the guide.</p></div></section>
<section class="section soft">
<div class="wrap narrow">
<h2>Choose what to improve first.</h2>
<a class="button" href={nextStep.href}>{nextStep.label}</a>
<p class="small" style="margin-top:20px">Architect Advantage is the optional paid implementation membership. Live member implementation calls are part of that paid offer.</p></div></section></main>
<LegacyFooter /><script is:inline>
(function(){
  var resources={"starter-kit":["/vault-starter","Open your Claude Starter Kit"],"claude-clearly":["/vault-claude-clearly","Open Claude, Clearly"],"switch-to-claude":["/switch","Return to Switch to Claude"],"reel":["/downloads/wwuai-reel-kit.zip","Download the reel kit"]};
  var selected=resources[new URLSearchParams(location.search).get("source")];
  if(selected){var link=document.getElementById("resource-link");link.href=selected[0];link.textContent=selected[1];document.getElementById("requested-resource").hidden=false;}
  document.querySelectorAll('.yr').forEach(function(e){var y=new Date().getFullYear();e.textContent=y>2026?'2026–'+y:'2026';});
})();
</script></Legacy>
